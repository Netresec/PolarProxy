# PolarProxy environment variables

PP_PROXY=10443,80,443
PP_SOCKS=1080
PP_HTTPCONNECT=8080
PP_NONTLS=allow
PP_CERTHTTP=10080
PP_EXPORT=/var/log/polarproxy/polarproxy.cer
PP_FLOWLOG=/var/log/polarproxy/proxyflows.log
PP_PCAPOVERIP=0.0.0.0:57012
PP_OUTPUTDIR=/var/log/polarproxy/
PP_VERBOSE=1

# Optionally use a pre-generated root CA certificate in PKCS12 format
#PP_CACERT=load:/home/polarproxy/.local/share/root.p12:Passw0rd!

# Set a keyfile if you have a commercial license for PolarProxy inside the home directory volume so it's persistent and writable
#PP_KEYFILE=/home/polarproxy/.local/share/polarproxy.key
# It is also possible to specify the license key as an environment variable
#PP_KEY=${PP_KEY}